{
  "name": "@wrensecurity/commons-ui-build",
  "version": "0.0.0",
  "description": "Wren Security UI Commons - Build",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    "./gulp": "./src/gulp.js",
    "./vite": "./src/vite.js"
  },
  "files": [
    "dist/index.cjs",
    "src/*"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "test": "vitest",
    "build": "rollup -c",
    "package": "npm pack --pack-destination dist"
  },
  "dependencies": {
    "@babel/core": "^7.23.3",
    "@babel/plugin-transform-modules-amd": "^7.23.3",
    "@babel/preset-env": "^7.23.3",
    "@rollup/plugin-alias": "^5.1.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@wrensecurity/eslint-config": "^0.2.0",
    "eslint": "^8.52.0",
    "gulp": "^4.0.2",
    "gulp-eslint-new": "^1.8.4",
    "jsdoc": "4.0.2",
    "less": "^4.2.0",
    "magic-string": "^0.30.17",
    "postcss": "^8.4.31",
    "postcss-minify": "^1.1.0",
    "requirejs": "^2.3.6",
    "rimraf": "^5.0.5",
    "rollup": "^4.6.0",
    "vite": "^6.2.6"
  },
  "overrides": {
    "glob-parent": "6.0.2",
    "glob-watcher": "6.0.0",
    "node-fetch": "2.7.0"
  },
  "devDependencies": {
    "@rollup/pluginutils": "^5.1.4",
    "vitest": "^3.1.1"
